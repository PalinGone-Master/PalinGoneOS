# PalinGoneOS — machine FICTIVE avec une carte NVIDIA ancienne (GTX 9xx/10xx, pilote 580),
# utilisée uniquement par la mise à jour automatique pour vérifier que le pilote NVIDIA
# se construit toujours avant de publier une version.
{
  palingoneos.nvidia.enable = true;
  palingoneos.nvidia.legacy = true;
}
